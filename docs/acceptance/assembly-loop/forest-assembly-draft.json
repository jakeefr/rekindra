    },
    {
      "asset_id": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "observed": "Pale crooked woody limbs interlace through dense forest; moss hangs over forks and upper branches. Olive and muted green foliage behind gray-brown bark.",
      "created": "An invented branching drawbridge with two rising fork rails and attached moss, all turning together on one root hinge."
    }
